---
import BaseLayout from '@sfw/ui';
import { OurWorkPage } from '@sfw/ui';
import { serviceConfigs } from '@sfw/content';
import { servicePageImages } from '../data/images';
import data from '../data/images.json';

const config = serviceConfigs['lead-paint'];
const jsonData = data as Record<string, unknown>;
const lightboxGalleries = (jsonData.lightboxGalleries ?? []) as {
  id: string;
  name: string;
  images: { src: string; alt: string }[];
}[];
const beforeAfterPairs = (jsonData.beforeAfterPairs ?? []) as {
  id: string;
  name: string;
  before: string;
  after: string;
  alt: string;
  beforeLabel?: string;
  afterLabel?: string;
}[];
---

<BaseLayout config={config} title="Our Work" description="Browse our completed lead paint projects">
  <OurWorkPage
    title="Our Work"
    subtitle="Browse our completed lead paint abatement, remediation, and restoration projects."
    beforeAfterPairs={beforeAfterPairs}
    lightboxGalleries={lightboxGalleries}
    servicePageImages={servicePageImages}
  />
</BaseLayout>
