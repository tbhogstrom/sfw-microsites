{
  "buildCommand": "cd ../.. && npx turbo build --filter=somerset-hills",
  "installCommand": "cd ../.. && npm install",
  "framework": "astro",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
