# Vercel Blob — required. Copy from a working app (e.g. apps/reports-portal/.env.local)
# or generate from the Vercel dashboard once the project is linked to a Blob store.
BLOB_READ_WRITE_TOKEN=

# HubSpot Forms API — required for "Get a Quote" lead submission.
# Find these in your HubSpot account: Settings → Tools → Forms → choose form → embed code.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Optional: only set if your HubSpot Forms endpoint requires authenticated submits.
# HUBSPOT_BEARER=
