---
import { cn } from '@sfw/utils';
import type { BaseProps } from '@sfw/ui/types';
import Button from '../ui/Button.astro';

export interface Props extends BaseProps {
  title: string;
  priceRange: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  highlighted?: boolean;
}

const {
  title,
  priceRange,
  features,
  ctaText = 'Get Estimate',
  ctaHref = '#contact',
  highlighted = false,
  class: className = '',
  ...rest
} = Astro.props;
---

<div
  class={cn(
    'rounded-lg p-6 flex flex-col',
    highlighted
      ? 'bg-accent/5 border-2 border-accent shadow-elevated'
      : 'bg-white border border-neutral-200 shadow-card',
    className,
  )}
  {...rest}
>
  <h3 class="text-xl font-heading font-bold text-neutral-900 mb-2">{title}</h3>
  <div class="text-3xl font-bold text-accent mb-4">{priceRange}</div>
  <ul class="flex-1 space-y-3 mb-6">
    {
      features.map((feature) => (
        <li class="flex items-start gap-2 text-neutral-700">
          <span class="text-green-600 mt-0.5">✓</span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <Button href={ctaHref} variant={highlighted ? 'primary' : 'outline'} fullWidth>
    {ctaText}
  </Button>
</div>
