---
import { cn } from '@sfw/utils';
import type { BaseProps } from '@sfw/ui/types';
import OptimizedImg from '../ui/OptimizedImg.astro';

export interface LightboxImage {
  src: string;
  alt: string;
  thumbnail?: string;
  caption?: string;
}

export interface Props extends BaseProps {
  images: LightboxImage[];
  columns?: 2 | 3 | 4;
  /** Intrinsic dimensions for gallery thumbnails (default 400x300 — 4:3 matches the aspect container). */
  thumbnailWidth?: number;
  thumbnailHeight?: number;
  /** Intrinsic dimensions for the lightbox main display (default 1600x1200). */
  lightboxWidth?: number;
  lightboxHeight?: number;
}

const {
  images,
  columns = 3,
  thumbnailWidth = 400,
  thumbnailHeight = 300,
  lightboxWidth = 1600,
  lightboxHeight = 1200,
  class: className = '',
  ...rest
} = Astro.props;
const lightboxId = `lightbox-${Math.random().toString(36).substr(2, 9)}`;

const colClasses = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
};
---

<div class={cn('', className)} {...rest}>
  <div class={cn('grid gap-3', colClasses[columns])}>
    {
      images.map((image, i) => (
        <button
          type="button"
          class="overflow-hidden rounded-lg cursor-pointer group focus:outline-none focus:ring-2 focus:ring-accent bg-neutral-100"
          data-lightbox-trigger={lightboxId}
          data-index={i}
          data-caption={image.caption || image.alt}
          data-full-src={image.src}
        >
          <div class="aspect-[4/3] relative">
            <OptimizedImg
              src={image.thumbnail || image.src}
              alt={image.alt}
              width={thumbnailWidth}
              height={thumbnailHeight}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          {(image.caption || image.alt) && (
            <div class="px-2.5 py-2 text-left">
              <p class="text-xs text-neutral-600 leading-snug line-clamp-2">
                {image.caption || image.alt}
              </p>
            </div>
          )}
        </button>
      ))
    }
  </div>

  <dialog
    id={lightboxId}
    class="fixed inset-0 w-full h-full max-w-none max-h-none m-0 p-0 bg-black/95 backdrop:bg-transparent"
  >
    <div class="flex flex-col w-full h-full">
      <!-- Top bar -->
      <div class="flex items-center justify-between px-4 py-3 shrink-0">
        <span data-lightbox-counter class="text-white/70 text-sm font-medium"></span>
        <button
          data-lightbox-close
          class="text-white/70 hover:text-white text-2xl leading-none focus:outline-none p-1"
          aria-label="Close">&#x2715;</button
        >
      </div>

      <!-- Image area -->
      <div class="flex-1 flex items-center justify-center relative min-h-0 px-12">
        <button
          data-lightbox-prev
          class="absolute left-2 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-3xl z-10 focus:outline-none p-2"
          aria-label="Previous">&#x2039;</button
        >
        <button
          data-lightbox-next
          class="absolute right-2 top-1/2 -translate-y-1/2 text-white/60 hover:text-white text-3xl z-10 focus:outline-none p-2"
          aria-label="Next">&#x203A;</button
        >
        <OptimizedImg
          data-lightbox-img
          src=""
          alt=""
          width={lightboxWidth}
          height={lightboxHeight}
          class="max-w-full max-h-full object-contain"
        />
      </div>

      <!-- Caption bar -->
      <div class="shrink-0 px-6 py-3 text-center">
        <p data-lightbox-caption class="text-white/80 text-sm leading-relaxed max-w-2xl mx-auto">
        </p>
      </div>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const dialogId = trigger.getAttribute('data-lightbox-trigger')!;
      const index = parseInt(trigger.getAttribute('data-index') || '0', 10);
      const dialog = document.getElementById(dialogId) as HTMLDialogElement;
      if (!dialog) return;

      const triggers = Array.from(
        document.querySelectorAll(`[data-lightbox-trigger="${dialogId}"]`),
      );
      const images = triggers.map((t) => ({
        src: t.getAttribute('data-full-src') || t.querySelector('img')!.src,
        alt: t.querySelector('img')!.alt,
        caption: t.getAttribute('data-caption') || '',
      }));

      let current = index;
      const imgEl = dialog.querySelector('[data-lightbox-img]') as HTMLImageElement;
      const captionEl = dialog.querySelector('[data-lightbox-caption]') as HTMLElement;
      const counterEl = dialog.querySelector('[data-lightbox-counter]') as HTMLElement;

      const show = (i: number) => {
        current = i;
        imgEl.src = images[i].src;
        imgEl.alt = images[i].alt;
        captionEl.textContent = images[i].caption;
        counterEl.textContent = `${i + 1} / ${images.length}`;
      };

      show(current);
      dialog.showModal();

      const closeBtn = dialog.querySelector('[data-lightbox-close]');
      const prevBtn = dialog.querySelector('[data-lightbox-prev]');
      const nextBtn = dialog.querySelector('[data-lightbox-next]');

      const onClose = () => dialog.close();
      const onPrev = () => show((current - 1 + images.length) % images.length);
      const onNext = () => show((current + 1) % images.length);
      const onKey = (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'ArrowLeft') onPrev();
        else if (ke.key === 'ArrowRight') onNext();
        else if (ke.key === 'Escape') onClose();
      };
      const onBackdrop = (e: Event) => {
        if (e.target === dialog) onClose();
      };

      closeBtn?.addEventListener('click', onClose);
      prevBtn?.addEventListener('click', onPrev);
      nextBtn?.addEventListener('click', onNext);
      dialog.addEventListener('keydown', onKey);
      dialog.addEventListener('click', onBackdrop);
    });
  });
</script>
