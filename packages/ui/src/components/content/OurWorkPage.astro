---
/**
 * OurWorkPage.astro — Shared "Our Work" gallery page component
 * Renders all available image data: before/after sliders, split journey galleries,
 * service page photo grids. Adapts based on what data is provided.
 */
import BeforeAfter from './BeforeAfter.astro';
import ImageLightbox from './ImageLightbox.astro';

export interface ServicePageImage {
  title: string;
  description: string;
  image: string;
  href: string;
}

export interface BeforeAfterPair {
  id: string;
  name: string;
  before: string;
  after: string;
  alt: string;
  beforeLabel?: string;
  afterLabel?: string;
}

export interface LightboxGallery {
  id: string;
  name: string;
  images: { src: string; alt: string; thumbnail?: string }[];
}

export interface Props {
  title?: string;
  subtitle?: string;
  beforeAfterPairs?: BeforeAfterPair[];
  lightboxGalleries?: LightboxGallery[];
  servicePageImages?: ServicePageImage[];
}

const {
  title = 'Our Work',
  subtitle = 'Browse our completed projects — from initial assessment through finished repairs.',
  beforeAfterPairs = [],
  lightboxGalleries = [],
  servicePageImages = [],
} = Astro.props;

const hasBeforeAfter = beforeAfterPairs.length > 0;
const hasGalleries = lightboxGalleries.length > 0;
const hasServiceImages = servicePageImages.length > 0;
---

<div class="py-12">
  <div class="container mx-auto px-4">
    <h1 class="text-4xl font-heading font-bold mb-2">{title}</h1>
    <p class="text-neutral-500 mb-12 max-w-2xl">{subtitle}</p>

    <!-- Before/After Sliders -->
    {
      hasBeforeAfter && (
        <section class="mb-16">
          <h2 class="text-2xl font-heading font-bold mb-6 border-b pb-2">Before & After</h2>
          <div class="grid md:grid-cols-2 gap-8">
            {beforeAfterPairs.map((pair) => (
              <div>
                <h3 class="text-lg font-semibold mb-3 text-neutral-700">{pair.name}</h3>
                <BeforeAfter
                  before={pair.before}
                  after={pair.after}
                  alt={pair.alt}
                  beforeLabel={pair.beforeLabel}
                  afterLabel={pair.afterLabel}
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Split Journey Galleries -->
    {
      hasGalleries && (
        <section class="mb-16">
          <h2 class="text-2xl font-heading font-bold mb-6 border-b pb-2">Project Galleries</h2>
          {lightboxGalleries.map((gallery) => (
            <div class="mb-12 last:mb-0">
              <h3 class="text-lg font-semibold mb-4 text-neutral-700">{gallery.name}</h3>
              {gallery.images.length >= 3 ? (
                <div class="max-w-2xl">
                  <div class="grid grid-cols-2 gap-2 mb-4">
                    <div class="relative bg-neutral-100 rounded-xl overflow-hidden">
                      <div class="aspect-[4/3]">
                        <img
                          src={gallery.images[0].src}
                          alt={gallery.images[0].alt}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded">
                        Before
                      </span>
                    </div>
                    <div class="relative bg-neutral-100 rounded-xl overflow-hidden">
                      <div class="aspect-[4/3]">
                        <img
                          src={gallery.images[gallery.images.length - 1].src}
                          alt={gallery.images[gallery.images.length - 1].alt}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <span class="absolute top-3 left-3 bg-green-600 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded">
                        After
                      </span>
                    </div>
                  </div>
                  <div>
                    <div class="flex items-center gap-2 mb-3">
                      <div class="h-px flex-1 bg-neutral-200" />
                      <span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">
                        The Process
                      </span>
                      <div class="h-px flex-1 bg-neutral-200" />
                    </div>
                    <div class="flex gap-3 overflow-x-auto pb-3 snap-x snap-mandatory">
                      {gallery.images.slice(1, -1).map((img, i) => (
                        <div class="snap-start shrink-0 w-48 md:w-56">
                          <div class="relative bg-neutral-100 rounded-lg overflow-hidden">
                            <div class="aspect-[4/3]">
                              <img
                                src={img.src}
                                alt={img.alt}
                                class="w-full h-full object-cover"
                                loading="lazy"
                              />
                            </div>
                            <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                              Step {i + 1}
                            </span>
                          </div>
                          <p class="text-xs text-neutral-500 mt-2 leading-snug line-clamp-2">
                            {img.alt}
                          </p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <ImageLightbox images={gallery.images} columns={3} />
              )}
            </div>
          ))}
        </section>
      )
    }

    <!-- Service Page Images Grid -->
    {
      hasServiceImages && (
        <section class="mb-16">
          <h2 class="text-2xl font-heading font-bold mb-6 border-b pb-2">All Project Photos</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {servicePageImages.map((img) => (
              <a href={img.href} class="group block">
                <div class="bg-neutral-100 rounded-lg overflow-hidden">
                  <div class="aspect-[4/3]">
                    <img
                      src={img.image}
                      alt={img.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                </div>
                <div class="px-1 py-2">
                  <p class="text-sm font-medium text-neutral-700 line-clamp-1">{img.title}</p>
                  {img.description && img.description !== 'General' && (
                    <p class="text-xs text-neutral-500 line-clamp-1">{img.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</div>
