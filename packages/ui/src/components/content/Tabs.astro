---
import { cn } from '@sfw/utils';
import type { BaseProps } from '@sfw/ui/types';

export interface TabItem {
  label: string;
  content: string; // HTML content
}

export interface Props extends BaseProps {
  tabs: TabItem[];
  defaultTab?: number;
}

const { tabs, defaultTab = 0, class: className = '', ...rest } = Astro.props;
const tabsId = `tabs-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={cn('', className)} data-tabs={tabsId} {...rest}>
  <div role="tablist" class="flex border-b border-neutral-200 gap-1">
    {
      tabs.map((tab, i) => (
        <button
          role="tab"
          id={`${tabsId}-tab-${i}`}
          aria-selected={i === defaultTab ? 'true' : 'false'}
          aria-controls={`${tabsId}-panel-${i}`}
          tabindex={i === defaultTab ? 0 : -1}
          class={cn(
            'px-4 py-3 text-sm font-medium border-b-2 -mb-px transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2',
            i === defaultTab
              ? 'border-accent text-accent'
              : 'border-transparent text-neutral-500 hover:text-neutral-700 hover:border-neutral-300',
          )}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, i) => (
      <div
        role="tabpanel"
        id={`${tabsId}-panel-${i}`}
        aria-labelledby={`${tabsId}-tab-${i}`}
        class={cn('py-6', i !== defaultTab && 'hidden')}
      >
        <Fragment set:html={tab.content} />
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll('[data-tabs]').forEach((container) => {
    const tabButtons = container.querySelectorAll('[role="tab"]');
    const panels = container.querySelectorAll('[role="tabpanel"]');

    const activate = (index: number) => {
      tabButtons.forEach((btn, i) => {
        const active = i === index;
        btn.setAttribute('aria-selected', active.toString());
        btn.setAttribute('tabindex', active ? '0' : '-1');
        btn.classList.toggle('border-accent', active);
        btn.classList.toggle('text-accent', active);
        btn.classList.toggle('border-transparent', !active);
        btn.classList.toggle('text-neutral-500', !active);
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle('hidden', i !== index);
      });
    };

    tabButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => activate(i));
      btn.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        let newIndex: number;
        if (ke.key === 'ArrowRight') newIndex = (i + 1) % tabButtons.length;
        else if (ke.key === 'ArrowLeft') newIndex = (i - 1 + tabButtons.length) % tabButtons.length;
        else if (ke.key === 'Home') newIndex = 0;
        else if (ke.key === 'End') newIndex = tabButtons.length - 1;
        else return;
        ke.preventDefault();
        activate(newIndex);
        (tabButtons[newIndex] as HTMLElement).focus();
      });
    });
  });
</script>
